---
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/guides', label: 'Guides' },
  { href: '/topics', label: 'Topics' },
];

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--color-ink-line)] bg-[var(--color-ink)]"
>
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 py-3 md:h-16 md:flex-nowrap md:py-0">
    <a
      href="/"
      class="flex items-center text-[var(--color-ink-fg)]"
      aria-label="Revanite — home"
    >
      <Wordmark class="h-6 w-auto md:h-7" />
    </a>

    <a href="https://grc.store" class="btn text-sm bg-[var(--color-ink-fg)] text-[var(--color-ink)] hover:bg-[var(--color-brand)] md:order-last">grc.store</a>

    <!-- Wraps to its own row below md so it stays reachable without a menu script. -->
    <nav class="w-full pt-2 md:w-auto md:flex-1 md:pt-0" aria-label="Primary">
      <ul class="flex items-center gap-6 text-sm text-[var(--color-ink-muted)] md:gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'transition-colors hover:text-[var(--color-ink-fg)]',
                  path.startsWith(item.href) && 'text-[var(--color-ink-fg)]',
                ]}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

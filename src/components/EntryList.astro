---
import { formatDate, href, type Guide, type Post } from '../lib/content';

interface Props {
  entries: (Post | Guide)[];
}

const { entries } = Astro.props;
---

<ul
  class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
>
  {
    entries.map((e) => (
      <li class="overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)]">
        <a
          href={href(e)}
          class="group flex h-full flex-col gap-3 p-6 transition-colors hover:bg-[var(--color-accent-soft)]"
        >
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">
            {e.collection === 'blog'
              ? formatDate(e.data.date)
              : e.data.layout === 'how-to'
                ? 'How-to guide'
                : 'Explainer'}
          </span>
          <h3 class="text-lg font-semibold tracking-tight">{e.data.title}</h3>
          <p class="text-sm leading-relaxed text-[var(--color-muted)]">{e.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>

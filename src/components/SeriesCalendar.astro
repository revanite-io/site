---
// The series calendar: one door per day. A released day's door opens onto its guide; a locked door
// shows only its date, so nothing about that day is in the built page until it releases.
import { getAllGuides, href, type Guide } from '../lib/content';

interface Props {
  intro: Guide;
}

const { intro } = Astro.props;
const released = (await getAllGuides()).filter((g) => g.data.series === intro.id);
// Day 1 falls on the intro's `start:` date.
const dateOf = (n: number) => new Date(intro.data.start!.valueOf() + (n - 1) * 86_400_000);
const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const longDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const open = released.length;
---

<ol
  class="advent-doors"
  aria-label={`The ${intro.data.days} days, ${open ? `${open} open` : 'all locked'}`}
>
  {
    Array.from({ length: intro.data.days! }, (_, i) => {
      const date = dateOf(i + 1);
      const page = released.find((g) => g.data.day === i + 1);
      return page ? (
        <li data-open>
          <a href={href(page)} aria-label={`${longDate(date)}: ${page.data.title}`} title={page.data.title}>
            <span>{month(date)}</span> {date.getUTCDate()}
          </a>
        </li>
      ) : (
        <li data-locked>
          <span>{month(date)}</span> {date.getUTCDate()}
        </li>
      );
    })
  }
</ol>

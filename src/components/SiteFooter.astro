---
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();

const groups = [
  {
    heading: 'Read',
    links: [
      { href: '/blog', label: 'Blog' },
      { href: '/guides', label: 'Guides' },
      { href: '/topics', label: 'Topics' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
  {
    heading: 'Projects',
    links: [
      { href: 'https://gemara.openssf.org', label: 'Gemara', external: true },
      { href: 'https://privateerproj.com', label: 'Privateer', external: true },
      { href: 'https://grc.store', label: 'grc.store', external: true },
      { href: 'https://baseline.openssf.org', label: 'OpenSSF Baseline (OSPS Baseline)', external: true },
      { href: 'https://github.com/ossf/pvtr-github-repo-scanner', label: 'OSPS Baseline scanner', external: true },
      { href: 'https://security-insights.openssf.org', label: 'Security Insights', external: true },
    ],
  },
  {
    heading: 'Revanite',
    links: [{ href: 'https://github.com/revanite-io', label: 'GitHub', external: true }],
  },
];
---

<footer class="border-t border-[var(--color-ink-line)] bg-[var(--color-ink)]">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_3fr]">
    <div>
      <Wordmark class="h-6 w-auto text-[var(--color-ink-fg)]" />
      <p class="mt-3 max-w-sm text-sm text-[var(--color-ink-muted)]">
        The open source stack for GRC engineering: Gemara, Privateer, and grc.store.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8 md:grid-cols-3">
      {
        groups.map((group) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[var(--color-ink-muted)]">
              {group.heading}
            </h3>
            <ul class="mt-4 space-y-2 text-sm">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink-fg)]"
                    {...('external' in link && link.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="border-t border-[var(--color-ink-line)]">
    <div
      class="container-page flex flex-col items-start justify-between gap-2 py-6 text-xs text-[var(--color-ink-muted)] sm:flex-row sm:items-center"
    >
      <span>&copy; {year} Revanite. All rights reserved.</span>
      <span>For informational purposes. Not legal advice.</span>
    </div>
  </div>
</footer>

---
// Index page shell: blog, guides, topics and each topic page.
import Layout from './Layout.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  jsonLd?: object[];
}

const { eyebrow, title, description, jsonLd } = Astro.props;
---

<Layout title={`${title} — Revanite`} description={description} jsonLd={jsonLd}>
  <section class="border-t border-[var(--color-line)]">
    <div class="container-page py-16 md:py-20">
      <div class="max-w-3xl">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
        <p class="mt-6 text-pretty text-lg text-[var(--color-muted)]">{description}</p>
      </div>
      <slot />
    </div>
  </section>
</Layout>

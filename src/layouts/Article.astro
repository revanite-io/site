---
// Shared page for blog posts and guides: header, rendered Markdown, topic links, JSON-LD.
import { getEntries, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from './Layout.astro';
import EntryList from '../components/EntryList.astro';
import { formatDate, getGuides, hasTag, type Guide, type Post } from '../lib/content';

interface Props {
  entry: Post | Guide;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const authors = await getEntries(data.authors);
const topics = await getEntries(data.tags);

const isPost = entry.collection === 'blog';
const guide = entry.collection === 'guides' ? entry.data : undefined;
const published = entry.data.date;
const updated = entry.data.updated;

const section = isPost ? { href: '/blog', label: 'All posts' } : { href: '/guides', label: 'All guides' };
const eyebrow = isPost ? 'Blog' : guide?.layout === 'how-to' ? 'How-to guide' : 'Explainer';

// Explainers end with the how-to guides that share a topic.
const related =
  guide?.layout === 'explainer'
    ? (await getGuides()).filter(
        (g) => g.data.layout === 'how-to' && data.tags.some((t) => hasTag(g, t.id)),
      )
    : [];

const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': isPost ? 'BlogPosting' : 'TechArticle',
    headline: data.title,
    description: data.description,
    url,
    ...(published && { datePublished: published.toISOString() }),
    ...(updated && { dateModified: updated.toISOString() }),
    author: authors.map((a) => ({ '@type': 'Person', name: a.data.name, ...(a.data.url && { url: a.data.url }) })),
    publisher: { '@type': 'Organization', name: 'Revanite', url: 'https://revanite.io' },
    ...(data.image && { image: new URL(data.image, Astro.site).toString() }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isPost ? 'Blog' : 'Guides', item: new URL(section.href, Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: data.title, item: url },
    ],
  },
];
if (guide && guide.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}
---

<Layout title={`${data.title} — Revanite`} description={data.description} image={data.image} type="article" jsonLd={jsonLd}>
  <article class="border-t border-[var(--color-line)]">
    <div class="container-page py-16 md:py-20">
      <a
        href={section.href}
        class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)]"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4" />
        {section.label}
      </a>

      <header class="mt-10 max-w-3xl">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">{data.title}</h1>
        <p class="mt-6 text-pretty text-xl leading-relaxed text-[var(--color-muted)]">{data.description}</p>
        <p class="mt-6 text-sm text-[var(--color-subtle)]">
          {authors.map((a) => a.data.name).join(' and ')}
          {published && <> · <time datetime={published.toISOString()}>{formatDate(published)}</time></>}
          {updated && <> · Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        </p>
        {
          topics.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {topics.map((t) => (
                <li>
                  <a
                    href={`/topics/${t.id}`}
                    class="inline-flex items-center rounded-full border border-[var(--color-line-strong)] bg-[var(--color-surface)] px-3 py-1 text-xs font-medium uppercase tracking-widest text-[var(--color-muted)] hover:border-[var(--color-fg)]"
                  >
                    {t.data.title}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>
    </div>

    <div class="border-t border-[var(--color-line)] bg-[var(--color-surface)]">
      <div class="container-page py-16 md:py-20">
        {
          guide?.layout === 'how-to' && (guide.prerequisites.length > 0 || guide.outcome) && (
            <div class="mb-12 grid max-w-3xl gap-6 rounded-xl border border-[var(--color-line)] bg-[var(--color-bg)] p-6 sm:grid-cols-2">
              {guide.prerequisites.length > 0 && (
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-subtle)]">You need</p>
                  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[var(--color-muted)]">
                    {guide.prerequisites.map((p) => <li>{p}</li>)}
                  </ul>
                </div>
              )}
              {guide.outcome && (
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-subtle)]">You get</p>
                  <p class="mt-3 text-sm text-[var(--color-muted)]">{guide.outcome}</p>
                </div>
              )}
              {guide.testedWith && (
                <p class="text-xs text-[var(--color-subtle)] sm:col-span-2">Tested with {guide.testedWith}</p>
              )}
            </div>
          )
        }

        <div class:list={['prose prose-lg', guide?.layout === 'how-to' && 'how-to']}>
          <Content />
        </div>

        {
          guide && guide.faq.length > 0 && (
            <section class="mt-16 max-w-3xl">
              <h2 class="text-2xl font-semibold tracking-tight">Questions</h2>
              <dl class="mt-6 space-y-6">
                {guide.faq.map(({ q, a }) => (
                  <div>
                    <dt class="font-semibold">{q}</dt>
                    <dd class="mt-2 text-[var(--color-muted)]">{a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="border-t border-[var(--color-line)]">
          <div class="container-page py-16">
            <h2 class="text-2xl font-semibold tracking-tight">Related guides</h2>
            <div class="mt-8">
              <EntryList entries={related} />
            </div>
          </div>
        </div>
      )
    }
  </article>
</Layout>

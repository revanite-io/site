---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Revanite" description="This page does not exist." noindex>
  <section class="border-t border-[var(--color-line)]">
    <div class="container-page py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="eyebrow">404</p>
        <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
        <p class="mt-6 text-lg text-[var(--color-muted)]">
          The page you asked for isn't here. It may have moved, or the link may be mistyped.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/" class="btn btn-primary">Home</a>
          <a href="/blog" class="btn btn-secondary">Blog</a>
          <a href="/guides" class="btn btn-secondary">Guides</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
